{
  "manifest_version": 3,
  "name": "DOM to PDF Picker",
  "version": "1.0.0",
  "description": "Pick any element on a page and save it as a PDF with selectable text, via the browser's native print dialog.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pick element to print (Alt+Shift+P)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "scripting", "commands", "storage", "contextMenus"],
  "commands": {
    "toggle-picker": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Toggle element picker (long page)"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dom-to-pdf-picker@local.extension",
      "strict_min_version": "115.0"
    }
  }
}
